/.phpunit.cache
# Laravel rebuilds these from whatever is actually installed. Committed, they
# carry a dev machine's package list to a host that ran `composer install
# --no-dev`, and every artisan command there dies on a missing dev provider.
/bootstrap/cache/*.php
/node_modules
/public/hot
/public/storage
/storage/framework/cache/data/*
/storage/framework/sessions/*
/storage/framework/views/*.php
/storage/logs/*.log
/storage/*.key
/storage/pail
/vendor
.env
.env.backup
.env.production
.phpactor.json
.phpunit.result.cache
Homestead.json
Homestead.yaml
npm-debug.log
yarn-error.log
/auth.json
/.claude/settings.local.json
/.fleet
/.idea
/.nova
/.vscode
/.zed
/public/build
# Runtime uploads (logos, signatures, stamps) written by the app on the server
# — server data, not source. See GeneralSettingsController::upload().
/public/uploads
# Host-specific rewrite rules at the repo root, plus stray backups of them.
# public/.htaccess stays tracked: those are Laravel's own rules.
/.htaccess*